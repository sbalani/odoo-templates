<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- Title conditions vary between installations. Use the layout's
             named title block and retain the original block verbatim via $0. -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-if="o.move_type == 'in_invoice' and o.journal_id.type == 'purchase' and o.journal_id.name == 'Autofacturas - Revenue Share'">
                <t t-set="layout_document_title">
                    <span t-translation="off">FACTURA</span>
                    <span t-if="o.name and o.name != '/'" t-field="o.name"/>
                </t>
            </t>
            <t t-else="">$0</t>
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">
            <p name="afrs_self_billing_notice" class="mb-3"
               t-if="o.move_type == 'in_invoice' and o.journal_id.type == 'purchase' and o.journal_id.name == 'Autofacturas - Revenue Share'"
               t-translation="off">Facturación por el destinatario</p>
        </xpath>
    </template>
</odoo>
